# Los scripts y archivos de configuración deben conservar los saltos de línea de Linux,
# aunque se suban desde Windows. Un salto CRLF rompe Bash, Python, systemd y sudoers.
*.sh text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.service text eol=lf
src/niveles/bin/* text eol=lf
src/config/* text eol=lf
